# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are unanchored so they match at the repo root and in any subdirectory.

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
build/
.swc/
next-env.d.ts

# Sanity
dist/
.sanity/

# Testing
coverage/

# Environment variables
.env
.env.*
!.env.example
!.env.*.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
*.pem
.idea/
*.sw?
.playwright-mcp/*
